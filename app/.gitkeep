*{box-sizing:border-box}html,body{margin:0;padding:0;font-family:Inter,system-ui,-apple-system,sans-serif;background:#f5f7fb;color:#101828}button,input,select{font:inherit}a{text-decoration:none;color:inherit}.container{max-width:1180px;margin:auto;padding:24px}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 24px;background:#fff;border-bottom:1px solid #eaecf0;position:sticky;top:0;z-index:5}.brand{font-weight:800;font-size:20px}.nav{display:flex;gap:10px;align-items:center}.btn{border:0;border-radius:10px;padding:11px 15px;background:#155eef;color:white;font-weight:700;cursor:pointer}.btn.secondary{background:#eef4ff;color:#155eef}.btn.danger{background:#d92d20}.btn:disabled{opacity:.5}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.card{background:#fff;border:1px solid #eaecf0;border-radius:16px;padding:20px;box-shadow:0 2px 8px rgba(16,24,40,.04)}.balance{font-size:34px;font-weight:800;margin-top:8px}.muted{color:#667085}.title{font-size:30px;margin:8px 0 4px}.section{margin-top:24px}.form{display:grid;gap:12px}.label{font-size:13px;font-weight:700}.input,.select{width:100%;padding:12px;border:1px solid #d0d5dd;border-radius:10px;background:white}.notice{padding:12px;border-radius:10px;background:#fef3f2;color:#b42318}.success{padding:12px;border-radius:10px;background:#ecfdf3;color:#027a48}.tablewrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:700px}.table th,.table td{padding:12px;border-bottom:1px solid #eaecf0;text-align:left;font-size:13px}.pill{display:inline-block;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:700}.pending{background:#fffaeb;color:#b54708}.successpill{background:#ecfdf3;color:#027a48}.failed{background:#fef3f2;color:#b42318}.hero{padding:44px 0}.hero h1{font-size:44px;max-width:720px;margin:0 0 14px}.hero p{font-size:18px;color:#667085;max-width:650px}.actions{display:flex;gap:10px;flex-wrap:wrap}.stat{font-size:28px;font-weight:800}.small{font-size:12px}.@media(max-width:800px){.grid,.grid2{grid-template-columns:1fr}.top{padding:14px}.container{padding:16px}.hero h1{font-size:34px}}
.heroLogo{margin-bottom:20px}.heroLogo img{width:110px;height:110px;border-radius:24px;box-shadow:0 8px 24px rgba(16,24,40,.14)}.footer{max-width:1180px;margin:0 auto;padding:28px 24px 40px;display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;border-top:1px solid #eaecf0}.footerLinks{display:flex;gap:16px;flex-wrap:wrap}.footerLinks a,.contactCard a,.contactBar a,.contactMini a{color:#155eef}.contactCard{max-width:700px}.miniLogo{width:30px;height:30px;object-fit:cover;border-radius:8px;vertical-align:middle}.authBrand{display:flex;align-items:center;gap:10px;margin-bottom:14px;font-size:22px}.authBrand img{width:48px;height:48px;object-fit:cover;border-radius:12px}.contactMini{font-size:12px}.contactBar{margin-top:24px;padding:14px;border-radius:12px;background:#fff;border:1px solid #eaecf0;font-size:13px}.brand{display:flex;align-items:center;gap:8px}
