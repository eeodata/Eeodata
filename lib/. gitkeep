import {env} from './env';import {vtpassRequestId} from './refs';
const BASE='https://sandbox.vtpass.com/api';
async function request(path:string,opts:RequestInit={}){const r=await fetch(`${BASE}${path}`,{...opts,headers:{'Content-Type':'application/json','api-key':env.vtpassApiKey,'secret-key':env.vtpassSecretKey,...(opts.headers||{})},cache:'no-store'});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.response_description||'VTpass request failed');return d;}
export function buyAirtime(p:{serviceID:string;phone:string;amount:number;requestId?:string}){return request('/pay',{method:'POST',body:JSON.stringify({request_id:p.requestId||vtpassRequestId(),serviceID:p.serviceID,amount:p.amount,phone:p.phone})})}
export function buyData(p:{serviceID:string;phone:string;variation_code:string;amount:number;requestId?:string}){return request('/pay',{method:'POST',body:JSON.stringify({request_id:p.requestId||vtpassRequestId(),serviceID:p.serviceID,billersCode:p.phone,variation_code:p.variation_code,amount:p.amount,phone:p.phone})})}
export function buyCable(p:{serviceID:string;billersCode:string;variation_code:string;amount:number;phone:string;requestId?:string}){return request('/pay',{method:'POST',body:JSON.stringify({request_id:p.requestId||vtpassRequestId(),serviceID:p.serviceID,billersCode:p.billersCode,variation_code:p.variation_code,amount:p.amount,phone:p.phone})})}
export function buyElectricity(p:{serviceID:string;billersCode:string;variation_code:string;amount:number;phone:string;requestId?:string}){return request('/pay',{method:'POST',body:JSON.stringify({request_id:p.requestId||vtpassRequestId(),serviceID:p.serviceID,billersCode:p.billersCode,variation_code:p.variation_code,amount:p.amount,phone:p.phone})})}
export function requery(requestId:string){return request('/requery',{method:'POST',body:JSON.stringify({request_id:requestId})})}
export async function variations(serviceID:string){return request(`/service-variations?serviceID=${encodeURIComponent(serviceID)}`)}
export function mapStatus(d:any):'success'|'pending'|'failed'{const c=String(d?.code??'');const s=String(d?.content?.transactions?.status??'').toLowerCase();if(c==='000'&&s==='delivered')return'success';if(['pending','initiated'].includes(s)||['099','001','089'].includes(c))return'pending';if(c==='040'||['failed','reversed','reversal'].includes(s))return'failed';return'pending'}
